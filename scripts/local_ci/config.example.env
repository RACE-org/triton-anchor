# Copy this file to /home/localci/local_ci/config.env on the local server and edit it.

# Gitee CI relay repository. It stores task code on ci/* and results on local-ci-results.
GITEE_REPO_URL="https://gitee.com/race-org/triton-anchor-local-ci-results.git"
GITEE_OWNER="race-org"
GITEE_REPO="triton-anchor-local-ci-results"
# GitHub dispatch writes push tasks to ci/push/*, PR head tasks to
# ci/pr-<pr-number>/<source-branch>, PR base pointers to
# ci/base/pr-<pr-number>/<source-branch>, and manual full FlagGems tasks to
# ci/full/*. The poller runs push/head/full tasks; base pointers are consumed
# only for performance baselines.
# Discover all refs in this relay repository, then accept only those task refs.
GITEE_POLL_ALL_BRANCHES="1"
# Required only when GITEE_POLL_ALL_BRANCHES="0". Separate refs with commas or spaces.
GITEE_BRANCHES=""
# Applied after branch discovery. The local-ci-results branch is never selected.
GITEE_BRANCH_INCLUDE_REGEX="^ci/(pr-[0-9]+/.+|push/.+|full/.+)$"

# Optional token used to read the private relay, push results, and create commit comments.
# Keep the real token in config.env or the shell environment, not in git.
GITEE_TOKEN=""
GITEE_USERNAME="likehupochuan"
# Optional credentials forwarded into Docker only for fetching the ci/* task ref.
# Prefer a read-only relay token here; leave empty when the relay repository is public/readable.
LOCAL_CI_CONTAINER_GITEE_USERNAME="likehupochuan"
LOCAL_CI_CONTAINER_GITEE_TOKEN=""
# Backward-compatibility escape hatch. Keep 0 when running automatic fork PR code.
LOCAL_CI_ALLOW_WRITE_TOKEN_IN_CONTAINER="1"
GITEE_RESULT_CONTEXT="local-ci/sophgo-cmodel"

# Results use a dedicated branch in the same relay repository as the ci/* task
# refs. Under runs/, results are grouped into ci_full_<branch>/, ci_pr/, and ci_push/.
GITEE_RESULTS_OWNER="race-org"
GITEE_RESULTS_REPO="triton-anchor-local-ci-results"
GITEE_RESULTS_REPO_URL="https://gitee.com/race-org/triton-anchor-local-ci-results.git"
GITEE_RESULTS_BRANCH="local-ci-results"
GITEE_RESULTS_WEB_URL="https://gitee.com/race-org/triton-anchor-local-ci-results"
PUBLISH_GITEE_RESULTS="1"
GITEE_WEB_URL="https://gitee.com/race-org/triton-anchor-local-ci-results"

# Host-side runner settings.
LOCAL_CI_CONTAINER="anchor-sophgo-ci-prod"
LOCAL_CI_STATE_DIR="/home/localci/local_ci/local-ci-state"
LOCAL_CI_SCRIPT_DIR="/home/localci/local_ci/control_anchor/triton-anchor/scripts/local_ci"
LOCAL_CI_POLL_INTERVAL="60"
LOCAL_CI_WORKSPACE_HOST="/home/localci/local_ci/workspace"

# Fail-open worker observability. The poller writes atomic state under
# LOCAL_CI_STATE_DIR/health. A server-owned systemd timer may snapshot these
# facts and force-update the dedicated public Gitee health repository;
# monitoring failures never change Local CI task results.
LOCAL_CI_HEALTH_ENABLED="1"
LOCAL_CI_WORKER_ID="sophgo-cmodel-01"
LOCAL_CI_HEARTBEAT_INTERVAL_SECONDS="60"
LOCAL_CI_HEARTBEAT_STALE_SECONDS="180"
GITEE_WORKER_HEALTH_REPO_URL="https://gitee.com/likehupochuan/triton-anchor-worker-health.git"
GITEE_WORKER_HEALTH_BRANCH="race-org-localci"

# The long-running poller invokes maintenance only between complete scan loops.
# Run maintenance/manage_local_ci_state.py without --apply once before enabling
# this switch. The poller account must also have recursive delete access to every
# LOCAL_CI_ARTIFACT_HOST_ROOTS entry; containers commonly create these files as
# root, so configure a default ACL for the poller account as documented in README.
LOCAL_CI_MAINTENANCE_ENABLED="1"
LOCAL_CI_MAINTENANCE_INTERVAL_SECONDS="86400"
LOCAL_CI_SUCCESS_RETENTION_DAYS="14"
LOCAL_CI_FAILURE_RETENTION_DAYS="28"
LOCAL_CI_INCOMPLETE_RETENTION_DAYS="7"
LOCAL_CI_DOCKER_ORPHAN_GRACE_HOURS="72"
LOCAL_CI_ARTIFACT_HOST_ROOTS="/home/localci/local_ci/workspace/local-ci-artifacts:/home/localci/local_ci/profile-workspaces/sophgo-cmodel/local-ci-artifacts:/home/localci/local_ci/profile-workspaces/triton-3.3-frontend/local-ci-artifacts:/home/localci/local_ci/profile-workspaces/triton-3.6-frontend/local-ci-artifacts"

# Required server-owned execution profiles keyed by the exact LLVM commit in
# triton/cmake/llvm-hash.txt. Every accepted LLVM hash, including the existing
# 3.0 hash, must have a <hash>.env file that resolves inside this directory.
# A missing directory or file fails the task; no LLVM revision falls back to
# the Sophgo settings.
LOCAL_CI_PROFILE_DIR="/home/localci/local_ci/profiles"
# Required fields in each profile are LOCAL_CI_PROFILE_NAME,
# LOCAL_CI_CONTAINER, LOCAL_CI_WORKSPACE_HOST, LLVM_BUILD_DIR,
# PYTHON_VENV_ACTIVATE, RUN_BACKEND_STAGES and the four RUN_* feature switches
# below. A backend-enabled profile must also provide BACKEND_PROFILE plus the
# backend path, discovery name, test command and wheel pattern. To preserve the
# existing Triton 3.0 behavior, put its current Sophgo settings in
# 10dc3a8e916d73291269e5e2b82dd22681489aa1.env.
# A frontend-only profile may set:
#
#   LOCAL_CI_PROFILE_NAME="triton-3.3-frontend"
#   LOCAL_CI_CONTAINER="anchor-triton-3.3-ci"
#   LOCAL_CI_WORKSPACE_HOST="/home/localci/local_ci/workspace"
#   LLVM_BUILD_DIR="/workspace/llvm-a66376b0dc3b2ea8a84fda26faca287980986f78"
#   PYTHON_VENV_ACTIVATE="/opt/venv/bin/activate"
#   RUN_BACKEND_STAGES="false"
#   RUN_FLAGGEMS_TESTS="false"
#   RUN_COMPILE_BENCHMARK="false"
#   RUN_PASS_PROFILE="false"
#   RUN_IR_SERIALIZATION_BENCHMARK="false"
#   FRONTEND_BUILD_MODE="fresh"
#
# Triton 3.6 uses a separate profile named
# a992f29451b9e140424f35ac5e20177db4afbdc0.env and its matching LLVM/container.

# Non-blocking Codex AI review and targeted testing. The host owns the CLI, but
# AI CI uses a dedicated static credential directory instead of personal
# ~/.codex. The directory must contain readable config.toml and auth.json.
# Private 700/600 permissions are recommended; broader permissions only warn.
CODEX_BIN="/usr/local/bin/codex"
CODEX_AI_CI_HOME="/home/localci/local_ci/secrets/codex-ai"
RUN_CODEX_AI_CI="true"
CODEX_AI_CI_BRANCH_REGEX="^ci/(push/.+|pr-[0-9]+/.+)$"
CODEX_AI_CI_WORKSPACE_ROOT="/home/localci/local_ci/local-ci-state/codex-workspaces"
CODEX_AI_CI_TIMEOUT_SECONDS="3600"
# Shared deadline for snapshot creation, temporary-container startup and input copying.
CODEX_AI_CI_PREPARE_TIMEOUT_SECONDS="1500"
CODEX_AI_CI_STARTUP_TIMEOUT_SECONDS="900"
CODEX_AI_CI_REASONING_EFFORT="medium"
CODEX_AI_CI_MIN_GENERATED_TEST_CASES="1"
CODEX_AI_CI_MAX_GENERATED_TEST_CASES="15"
CODEX_AI_CI_MAX_GENERATED_TEST_FILES="5"
CODEX_AI_CI_MAX_TEST_COMMANDS="50"
CODEX_AI_CI_RECOMMENDED_COMMAND_TIMEOUT_SECONDS="900"
CODEX_AI_CI_TEST_BUDGET_SECONDS="2700"
CODEX_AI_CI_REPORT_RESERVE_SECONDS="450"
# Each task snapshots LOCAL_CI_CONTAINER, reuses /workspace read-only, copies
# the host Codex binary and dedicated credentials into a temporary container,
# and receives a writable exact-SHA checkout at /codex-workspace/checkout. No
# credentials are copied back. The container and image are always removed.
# This optional command only checks prerequisites:
#   CODEX_AI_CI_HOME=/home/localci/local_ci/secrets/codex-ai \
#     scripts/local_ci/codex_ai/setup_codex_ai_container.sh

# Container-side workspace. ANCHOR_DIR is deleted and freshly cloned for every
# task; backend/LLVM/PPL/FlagGems remain prepared and must not overlap it.
WORKSPACE="/workspace"
ANCHOR_DIR="/workspace/triton-anchor"
LLVM_BUILD_DIR="/workspace/llvm-release"
PPL_ROOT="/workspace/ppl-release"
LOCAL_CI_ARTIFACT_ROOT="/workspace/local-ci-artifacts"

# Backend profile. For another backend, change these paths/commands only.
# 当前 3.0 Sophgo profile 需显式包含下列 backend 配置；任务不会从
# 全局配置为其他 profile 继承这些 Sophgo 专用值。
BACKEND_PROFILE="sophgo-cmodel"
EXPECTED_TRITON_BACKEND="sophgo"
BACKEND_PATH="/workspace/triton-sophgo-backend"
BACKEND_ENVSETUP="envsetup.sh"
BACKEND_ENVSETUP_ARGS="PIO_CMODEL"
BACKEND_TEST_COMMAND="python3 tests/test_smoke.py && python3 tests/test_jit.py"
BACKEND_UNINSTALL_PACKAGES="triton-sophgo-backend triton_sophgo_backend"
BACKEND_WHEEL_PATTERN="triton_sophgo_backend-*.whl"
RUN_BACKEND_STAGES="true"
BACKEND_SKIP_REASON=""

# FlagGems defaults to a regular sample: select one fast passing op from each of 6 categories.
# The current whitelist contains 42 successful ops that completed within 600
# seconds in the 2026-07-28 full run. Norm and reduction remain full-only.
# Manual full runs are dispatched through ci/full/* with FLAGGEMS_TEST_MODE=full and use attachment-5 ops 1-127.
# Set FLAGGEMS_TEST_COMMAND to bypass the selector completely.
RUN_FLAGGEMS_TESTS="false"
FLAGGEMS_CLONE_DIR="/workspace/FlagGems"
FLAGGEMS_REF=""
FLAGGEMS_PIP_PACKAGES="scipy pytest"
FLAGGEMS_TEST_MODE="sample"
FLAGGEMS_SAMPLE_SIZE="6"
FLAGGEMS_RANDOM_SEED=""
FLAGGEMS_TEST_OP="abs"
FLAGGEMS_TEST_COMMAND=""
# The batch runner keeps each operator in a separate process and preserves the
# historical five-column Chinese CSV summary format.
FLAGGEMS_PYTEST_ARGS="--ref cpu -vs"
FLAGGEMS_IDLE_TIMEOUT_SECONDS="300"
FLAGGEMS_TOTAL_TIMEOUT_SECONDS="6000"
# Full mode treats TOTAL as a soft deadline. It extends only when new pytest
# nodes completed since the previous deadline, and never exceeds HARD.
FLAGGEMS_FULL_TIMEOUT_EXTENSION_SECONDS="1800"
FLAGGEMS_FULL_HARD_TIMEOUT_SECONDS="14400"
FLAGGEMS_CLEAR_CACHE="1"
FLAGGEMS_WHITELIST=""
FLAGGEMS_FULL_LIST=""
INSTALL_FLAGGEMS_PACKAGES="1"
#
# Build controls. "fresh" replaces the checkout and clears build/dist;
# "incremental" fetches and resets the existing checkout while preserving
# build, but still clears dist and rebuilds/reinstalls the wheel. If no checkout
# exists yet, incremental mode starts with a clone. Leave FRONTEND_BUILD_COMMAND
# empty to auto-select uv or python -m build.
PACKAGE_TOOL="auto"
PYTHON_BIN="python3"
PYTHON_VENV_ACTIVATE="/opt/venv/bin/activate"
SOURCE_ENVSETUP="1"
FRONTEND_BUILD_MODE="incremental"
FRONTEND_BUILD_COMMAND=""

# Compile-time regression. PR tasks compare these four kernels against the
# cached result for the PR base SHA. A missing baseline is measured once.
RUN_COMPILE_BENCHMARK="false"
COMPILE_BENCHMARK_KERNELS="add,mm,softmax,layernorm"
COMPILE_BENCHMARK_REPEAT="5"
COMPILE_BENCHMARK_WARMUP="1"
COMPILE_BENCHMARK_THRESHOLD="0.20"
COMPILE_BENCHMARK_TIMEOUT="30m"

# Pass-level profiling regression. This uses TRITON_ANCHOR_PROFILE=1 and runs
# separately from the end-to-end compile benchmark so timing diagnostics do not
# distort compile-time measurements.
RUN_PASS_PROFILE="false"
PASS_PROFILE_KERNELS="add,mm,softmax,layernorm"
PASS_PROFILE_REPEAT="3"
PASS_PROFILE_WARMUP="1"
PASS_PROFILE_THRESHOLD="0.20"
PASS_PROFILE_MIN_BASE_MS="1.0"
PASS_PROFILE_MIN_DELTA_MS="1.0"
PASS_PROFILE_TIMEOUT="30m"

# TTIR serialization/deserialization regression. The benchmark compiles each
# kernel once to obtain real TTIR cache files, then times text conversion and
# file-based MLIR parsing independently from normal kernel compilation.
RUN_IR_SERIALIZATION_BENCHMARK="false"
IR_SERIALIZATION_KERNELS="add,mm,softmax,layernorm"
IR_SERIALIZATION_REPEAT="20"
IR_SERIALIZATION_WARMUP="3"
IR_SERIALIZATION_METRICS="serialize,deserialize"
IR_SERIALIZATION_THRESHOLD="0.20"
IR_SERIALIZATION_MIN_BASE_MS="0.05"
IR_SERIALIZATION_MIN_DELTA_MS="0.05"
IR_SERIALIZATION_TIMEOUT="30m"

# Keep source/backend rebuild parallelism consistent in production.
MAX_JOBS="8"
CMAKE_BUILD_PARALLEL_LEVEL="8"
NINJAFLAGS="-j8"
UV_LINK_MODE="copy"
