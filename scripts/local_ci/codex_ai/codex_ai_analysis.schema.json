{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "主要变更、关键行为或失败诊断结论及其证据边界的简明总结。"
    },
    "merge_recommendation": {
      "type": "string",
      "description": "与 findings、Local CI、贡献者目标实现情况及证据充分程度一致的合入建议和前提。"
    },
    "change_request_assessment": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "partially_implemented",
            "not_implemented",
            "not_assessable",
            "not_applicable"
          ]
        },
        "contributor_goal": {"type": "string", "description": "贡献者声明要解决的问题或完成的功能。"},
        "expected_behavior": {"type": "string", "description": "声明的用户可观察行为、接口契约或验收结果。"},
        "implementation_summary": {"type": "string", "description": "diff 实际实现内容及其与声明的完整性或偏差。"},
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string"}
        }
      },
      "required": [
        "status",
        "contributor_goal",
        "expected_behavior",
        "implementation_summary",
        "evidence"
      ],
      "additionalProperties": false
    },
    "changed_files": {
      "type": "array",
      "description": "按可信 FILE-ID 覆盖全部变更文件，证明文件级审查完整性；不能代替跨文件行为推理。",
      "items": {
        "type": "object",
        "properties": {
          "file_id": {"type": "string", "pattern": "^FILE-[0-9]{3,}$"},
          "summary": {"type": "string", "description": "该文件实际改变的代码、配置、测试或文档契约。"},
          "impact": {"type": "string", "description": "对行为、调用方、状态、数据、兼容性、CI/发布或覆盖的影响。"},
          "validation_strategy": {"type": "string", "description": "实际静态检查、复用证据、执行命令及结果；未执行时说明原因和边界。"}
        },
        "required": ["file_id", "summary", "impact", "validation_strategy"],
        "additionalProperties": false
      }
    },
    "behavior_coverage": {
      "type": "object",
      "description": "跨文件记录正常、边界、错误、兼容和集成行为的范围、策略与结论。",
      "properties": {
        "normal": {
          "type": "object",
          "properties": {
            "scope": {"type": "string"},
            "strategy": {"type": "string"},
            "result": {"type": "string"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "boundary": {
          "type": "object",
          "properties": {
            "scope": {"type": "string"},
            "strategy": {"type": "string"},
            "result": {"type": "string"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "error": {
          "type": "object",
          "properties": {
            "scope": {"type": "string"},
            "strategy": {"type": "string"},
            "result": {"type": "string"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "scope": {"type": "string"},
            "strategy": {"type": "string"},
            "result": {"type": "string"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        },
        "integration": {
          "type": "object",
          "properties": {
            "scope": {"type": "string"},
            "strategy": {"type": "string"},
            "result": {"type": "string"}
          },
          "required": ["scope", "strategy", "result"],
          "additionalProperties": false
        }
      },
      "required": ["normal", "boundary", "error", "compatibility", "integration"],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "description": "仅包含证据充分、路径可达且对合入有意义的具体缺陷。",
      "items": {
        "type": "object",
        "properties": {
          "severity": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "category": {
            "type": "string",
            "enum": [
              "algorithm",
              "business-logic",
              "state-management",
              "cache-consistency",
              "concurrency",
              "resource-lifecycle",
              "data-integrity",
              "correctness",
              "regression",
              "security",
              "api-compatibility",
              "performance",
              "test-gap",
              "other"
            ]
          },
          "file_id": {"type": "string", "pattern": "^FILE-[0-9]{3,}$"},
          "line": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?$",
            "description": "可信变更文件中的正整数行号或起止有序的连续行范围；优先使用能够定位根因的最窄范围。"
          },
          "code_role": {"type": "string"},
          "title": {"type": "string"},
          "evidence": {"type": "string"},
          "impact": {"type": "string"},
          "fix_direction": {"type": "string"}
        },
        "required": [
          "severity",
          "category",
          "file_id",
          "line",
          "code_role",
          "title",
          "evidence",
          "impact",
          "fix_direction"
        ],
        "additionalProperties": false
      }
    },
    "suggested_tests": {
      "type": "array",
      "description": "尚未执行且能够关闭具体剩余风险或区分根因的验证建议。",
      "items": {
        "type": "object",
        "properties": {
          "priority": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "target": {"type": "string"},
          "description": {"type": "string"}
        },
        "required": ["priority", "target", "description"],
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "description": "已识别但因证据或环境限制尚未关闭的具体风险；没有时为空数组。",
      "items": {"type": "string"}
    },
    "test_assessment": {
      "type": "object",
      "description": "Codex 对复用 CI 证据、静态审查和实际命令是否足以支持当前结论的语义评估；执行事实由 Runner 派生。",
      "properties": {
        "evidence_level": {
          "type": "string",
          "enum": ["not_needed", "sufficient", "insufficient", "test_generation_error"]
        },
        "summary": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string"}
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {"type": "string"},
              "role": {
                "type": "string",
                "description": "validation 表示测试、构建或 lint 等正式验证；diagnostic 表示搜索、日志检查或环境探查。",
                "enum": ["validation", "diagnostic"]
              },
              "purpose": {
                "type": "string",
                "description": "简洁且稳定的验证目标；只有目标和覆盖范围等价的命令才使用相同文本。",
                "maxLength": 120
              },
              "evidence": {"type": "string"},
              "failure_classification": {
                "type": "string",
                "enum": ["none", "product", "flaky", "infrastructure", "unknown"]
              }
            },
            "required": ["command", "role", "purpose", "evidence", "failure_classification"],
            "additionalProperties": false
          }
        }
      },
      "required": ["evidence_level", "summary", "commands"],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "merge_recommendation",
    "change_request_assessment",
    "changed_files",
    "behavior_coverage",
    "findings",
    "suggested_tests",
    "residual_risks",
    "test_assessment"
  ],
  "additionalProperties": false
}
