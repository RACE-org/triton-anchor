{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triton-anchor.dev/schemas/backend-manifest-1.0.json",
  "title": "triton-anchor Backend Plugin Manifest",
  "type": "object",
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "abiFingerprint": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "nativeLibraryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)\\S(?:.*\\S)?$"
    },
    "nativeLibraryPaths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nativeLibraryPath"
      },
      "uniqueItems": true
    },
    "tritonRequirement": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        }
      },
      "additionalProperties": true
    },
    "plugin": {
      "type": "object",
      "required": [
        "plugin_id",
        "entry_point",
        "backend_protocol",
        "requires_triton",
        "targets",
        "isolation_mode"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "vendor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entry_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
        },
        "backend_protocol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requires_core": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requires_triton": {
          "$ref": "#/$defs/tritonRequirement"
        },
        "requires_llvm_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requires_llvm_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "requires_mlir_version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requires_mlir_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "targets": {
          "allOf": [
            {
              "$ref": "#/$defs/uniqueStrings"
            },
            {
              "minItems": 1
            }
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "requires_capabilities": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "isolation_mode": {
          "enum": ["python_only", "subprocess", "native_in_process"]
        },
        "native_libraries": {
          "$ref": "#/$defs/nativeLibraryPaths"
        },
        "abi_fingerprint": {
          "$ref": "#/$defs/abiFingerprint"
        },
        "priority": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isolation_mode": {
                "const": "python_only"
              }
            },
            "required": ["isolation_mode"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["native_libraries"]
                },
                {
                  "required": ["abi_fingerprint"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "isolation_mode": {
                "const": "subprocess"
              }
            },
            "required": ["isolation_mode"]
          },
          "then": {
            "not": {
              "required": ["abi_fingerprint"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "isolation_mode": {
                "const": "native_in_process"
              }
            },
            "required": ["isolation_mode"]
          },
          "then": {
            "required": ["native_libraries", "abi_fingerprint"],
            "properties": {
              "native_libraries": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
